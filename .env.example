APP_NAME=人事管理平台
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=zh_CN
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rsxt
DB_USERNAME=
DB_PASSWORD=

# Existing JSP business database. The application never migrates this schema.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=uchr
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=
LEGACY_DB_CHARSET=utf8
LEGACY_DB_COLLATION=utf8_general_ci
LEGACY_WRITE_ENABLED=false
PROFILE_CORRECTION_WRITE_TARGET=disabled
PROFILE_CORRECTION_PRODUCTION_WRITES_ENABLED=false
LEGACY_PROFILE_DB_USERNAME=
LEGACY_PROFILE_DB_PASSWORD=
LEGACY_STAGE_DATABASE=uchr_stage
LEGACY_STAGE_DB_HOST=
LEGACY_STAGE_DB_PORT=3306
LEGACY_STAGE_DB_USERNAME=
LEGACY_STAGE_DB_PASSWORD=
PROFILE_CORRECTION_TRANSACTIONAL_IDENTITY=false
LEGACY_PRIVATE_FILES_ENABLED=false
LEGACY_FILES_REMOTE_FALLBACK=true
LEGACY_FILES_DOWNLOAD_BASE_URL=http://10.1.12.184:8080
LEAVE_PRIVATE_ATTACHMENTS=false

# One-time copy credentials. Source connections are SELECT-only; do not use target admin for runtime.
COPY_SOURCE_LEGACY_HOST=
COPY_SOURCE_LEGACY_PORT=3306
COPY_SOURCE_LEGACY_DATABASE=uchr
COPY_SOURCE_LEGACY_USERNAME=
COPY_SOURCE_LEGACY_PASSWORD=
COPY_SOURCE_AUX_HOST=
COPY_SOURCE_AUX_PORT=3306
COPY_SOURCE_AUX_DATABASE=rsxt
COPY_SOURCE_AUX_USERNAME=
COPY_SOURCE_AUX_PASSWORD=
COPY_TARGET_HOST=10.1.12.183
COPY_TARGET_PORT=3306
COPY_TARGET_USERNAME=
COPY_TARGET_PASSWORD=

# Local, loopback-only preview of an existing enabled employee. Never enable in production.
PERSONNEL_LOCAL_PREVIEW=false
PERSONNEL_PREVIEW_USER_ID=

# Annual assessments: keep production writes off until workflow acceptance and cutover.
ASSESSMENT_WRITE_TARGET=disabled
ASSESSMENT_PRODUCTION_WRITES_ENABLED=false
LEGACY_ASSESSMENT_DB_USERNAME=
LEGACY_ASSESSMENT_DB_PASSWORD=

# Leave applications: use an isolated copy for acceptance before enabling production.
LEAVE_WRITE_TARGET=disabled
LEAVE_PRODUCTION_WRITES_ENABLED=false
LEGACY_LEAVE_DB_USERNAME=
LEGACY_LEAVE_DB_PASSWORD=
LEGACY_POSITION_DB_USERNAME=
LEGACY_POSITION_DB_PASSWORD=
POSITION_WRITE_TARGET=production
POSITION_PRODUCTION_WRITES_ENABLED=true
LEAVE_LEGACY_ATTACHMENT_HOST=rsgl.zufedfc.edu.cn
LEAVE_PUBLIC_ATTACHMENT_URL=

# Set this to the exact public HTTPS callback registered with the school CAS.
CAS_BASE_URL=https://cas.paas.zufedfc.edu.cn/cas
CAS_SERVICE_URL=https://rsxt.zufedfc.edu.cn/sso/callback
CAS_POST_LOGOUT_URL=https://rsxt.zufedfc.edu.cn/
CAS_ACCOUNT_ATTRIBUTE=user
CAS_VERIFY_TLS=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
